;
; LoiraExecutor.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = LoiraExecutor.cat
DriverVer = 08/25/2026,23.53.57.488
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
LoiraExecutor.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299 ; %13% support introduced in build 16299

[Standard.NTamd64.10.0...16299]
%LoiraExecutor.DeviceDesc% = LoiraExecutor_Device, Root\LoiraExecutor ; TODO: edit hw-id

[LoiraExecutor_Device.NT]
CopyFiles = File_Copy

[File_Copy]
LoiraExecutor.sys

;-------------- Service installation
[LoiraExecutor_Device.NT.Services]
AddService = LoiraExecutor,%SPSVCINST_ASSOCSERVICE%, LoiraExecutor_Service_Inst

; -------------- LoiraExecutor driver install sections
[LoiraExecutor_Service_Inst]
DisplayName    = %LoiraExecutor.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\LoiraExecutor.sys

[LoiraExecutor_Device.NT.Wdf]
KmdfService = LoiraExecutor, LoiraExecutor_wdfsect

[LoiraExecutor_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "LoiraExecutor Installation Disk"
LoiraExecutor.DeviceDesc = "LoiraExecutor Device"
LoiraExecutor.SVCDESC = "LoiraExecutor Service"
